# AMD Strategy Bot — Environment Configuration
# Copy to .env and fill in non-sensitive values.
# NEVER put passwords here — use keyring instead (see CREDENTIALS.md).

# ── Instrument & Execution ────────────────────────────────────────────────────
SYMBOL=XAUUSD
TIMEFRAME=M5
MANUAL_CONFIRM=true          # true until validated on demo

# ── Risk Management ───────────────────────────────────────────────────────────
RISK_PERCENT=1.0
MIN_RR=1.5
MAX_LOTS=5.0

# ── SL / TP ───────────────────────────────────────────────────────────────────
SL_PIPS=10.0                 # SL buffer above/below manipulation extreme
USE_PIP_TP=false             # false = use RISK_REWARD ratio
TP_PIPS=20.0                 # used when USE_PIP_TP=true
RISK_REWARD=2.0              # TP = risk × this (when USE_PIP_TP=false)
TP_BUFFER_PIPS=5.0           # extra buffer beyond range extreme (fallback TP)

# ── AMD Detection ─────────────────────────────────────────────────────────────
ACCUM_BARS=20
ACCUM_ATR_MULT=1.5
MANIP_PIPS=5.0
MANIP_LOOKBACK=10
FVG_LOOKBACK=8
CANDLE_COUNT=60

# ── Period Filter ─────────────────────────────────────────────────────────────
USE_PERIOD_FILTER=false
# Comma-separated period indices to allow (empty = all 48 allowed)
# Period index: 0=00:00 UTC, 26=13:00 UTC (NY open), 27=13:30 UTC, etc.
ALLOWED_PERIODS=
MAX_TRADES_PER_PERIOD=2

# ── ICT Session Filter ────────────────────────────────────────────────────────
USE_SESSION=true
GMT_OFFSET=0
ASIAN_START_H=23
ASIAN_END_H=9
LONDON_START_H=7
LONDON_END_H=16
NY_START_H=12
NY_END_H=21

# ── Day Quality ───────────────────────────────────────────────────────────────
HIGH_PROB_DAY=true           # Set false to sit out low-quality days

# ── MT5 Connection ────────────────────────────────────────────────────────────
# Passwords go in keyring, not here (see CREDENTIALS.md)
MT5_LOGIN=
MT5_SERVER=
MT5_PATH=

# ── Broker Profiles ───────────────────────────────────────────────────────────
# Activate with: python main.py --profile metaquotes
PROFILE_METAQUOTES_SYMBOL=XAUUSD
PROFILE_METAQUOTES_MT5_LOGIN=
PROFILE_METAQUOTES_MT5_SERVER=MetaQuotes-Demo
PROFILE_METAQUOTES_MT5_PATH=

PROFILE_BLACKBULL_SYMBOL=XAUUSDp
PROFILE_BLACKBULL_MT5_LOGIN=
PROFILE_BLACKBULL_MT5_SERVER=BlackBull Markets
PROFILE_BLACKBULL_MT5_PATH=

# ── Scan settings ─────────────────────────────────────────────────────────────
SCAN_INTERVAL=30             # seconds between scans
MAGIC_NUMBER=20260501
SLIPPAGE=20

# ── OctagonAI (financial research + news calendar) ────────────────────────────
# Get key from https://app.octagonai.co
OCTAGON_API_KEY=
